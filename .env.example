# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is ignored by git, so your values stay on your machine.

# Database Configuration
# For local Mac Homebrew setups, the default username is your Mac system username and the password is empty
DB_USER=your_mac_username
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognitive_os

# For standard PostgreSQL setups (e.g., Windows, Linux, Docker, pgAdmin):
# DB_USER=postgres
# DB_PASSWORD=your_password

# API Security
# Browser addresses allowed to call the API (comma-separated, no spaces). Every other website is rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
